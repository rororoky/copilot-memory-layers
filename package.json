{
  "name": "copilot-memory-layers",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive, source-backed guide to GitHub Copilot's memory layers.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs",
    "dev:astro": "astro dev",
    "build:astro": "astro build",
    "check:astro": "astro check",
    "preview:astro": "astro preview",
    "check:links:astro": "node scripts/check-links.mjs dist-astro",
    "verify:astro": "npm run check:astro && npm run build:astro && npm run check:links:astro"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/sitemap": "^3.7.4",
    "@types/node": "^26.6.6",
    "astro": "^7.4.8",
    "typescript": "^5.6.3",
    "vite": "^8.3.6"
  }
}
