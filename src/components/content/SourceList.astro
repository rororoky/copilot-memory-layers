---
import { getSource, sourceIndex } from '../../data/sources';

interface Props {
  ids: string[];
}

const { ids } = Astro.props;
const items = [...new Set(ids)].map((id) => ({
  id,
  source: getSource(id),
  index: sourceIndex(id),
}));
---

{items.length > 0 && (
  <div class="page-sources">
    <p class="page-sources__title">Official sources for this page</p>
    <p class="page-sources__note">
      Each item links to the page it was read from. Dates are verification dates, not publication
      dates.
    </p>
    <ol class="source-list">
      {items.map(({ id, source, index }) => (
        <li class="source-card" id={`src-${id}`}>
          <span class="source-card__index">{index}</span>
          <div>
            <p class="source-card__title">
              <a href={source.url} rel="noreferrer noopener" target="_blank">{source.title}</a>
            </p>
            <p class="source-card__meta">{source.publisher} · {source.usedFor}</p>
          </div>
          <span class="badge source-card__verified">checked {source.verifiedOn}</span>
        </li>
      ))}
    </ol>
  </div>
)}
