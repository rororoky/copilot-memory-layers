---
import BaseLayout from './BaseLayout.astro';
import PageHead from '../components/content/PageHead.astro';
import SourceList from '../components/content/SourceList.astro';
import Pager from '../components/chrome/Pager.astro';
import type { Chapter } from '../data/chapters';
import { site } from '../data/site';
import type { TocHeading } from '../lib/toc';

interface Props {
  chapter: Chapter;
  chapters: Chapter[];
  headings?: TocHeading[];
  sources?: string[];
  lede?: string;
  description?: string;
  noindex?: boolean;
}

const {
  chapter,
  chapters,
  headings = [],
  sources = [],
  lede = chapter.blurb,
  description = lede,
  noindex = false,
} = Astro.props;

const index = chapters.findIndex((item) => item.slug === chapter.slug);
const prev = index > 0 ? chapters[index - 1] : undefined;
const next = index >= 0 && index < chapters.length - 1 ? chapters[index + 1] : undefined;
const nextChapter =
  next ??
  (chapter.slug === 'sources'
    ? undefined
    : chapters.find((item) => item.slug === 'sources'));

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url.pathname;
const homeUrl = Astro.site
  ? new URL(import.meta.env.BASE_URL, Astro.site).toString()
  : import.meta.env.BASE_URL;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: chapter.title,
    description,
    url: canonical,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    isPartOf: { '@type': 'WebSite', name: site.title, url: homeUrl },
    author: { '@type': 'Organization', name: site.title },
    publisher: { '@type': 'Organization', name: site.title },
    inLanguage: 'en',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Overview', item: homeUrl },
      { '@type': 'ListItem', position: 2, name: chapter.title, item: canonical },
    ],
  },
];
---

<BaseLayout
  title={`${chapter.title} · ${site.title}`}
  description={description}
  page={chapter.slug}
  headings={headings}
  noindex={noindex}
  type="article"
  jsonLd={jsonLd}
>
  <PageHead
    eyebrow={`Chapter ${chapter.num} · ${chapter.group}`}
    title={chapter.title}
    lede={lede}
  />

  <slot />

  {sources.length > 0 && <SourceList ids={sources} />}

  <Pager current={chapter} prev={prev} next={nextChapter} />
</BaseLayout>
