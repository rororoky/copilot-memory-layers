---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterCard from '../components/content/ChapterCard.astro';
import Callout from '../components/content/Callout.astro';
import Cite from '../components/content/Cite.astro';
import SourceList from '../components/content/SourceList.astro';
import { sources } from '../data/sources';
import { site } from '../data/site';
import { getChapters } from '../lib/chapters';
import { withBase } from '../lib/url';
import type { TocHeading } from '../lib/toc';

const chapters = await getChapters();
const verified = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(new Date(site.verifiedOn));

const homeUrl = Astro.site
  ? new URL(import.meta.env.BASE_URL, Astro.site).toString()
  : import.meta.env.BASE_URL;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: homeUrl,
  description: site.tagline,
  inLanguage: 'en',
};

const teaserLayers = [
  { index: 0, name: 'Model weights', life: 'permanent', tone: 'l0' },
  { index: 1, name: 'Working memory', life: 'one chat', tone: 'l1' },
  { index: 2, name: 'Session memory', life: 'one chat', tone: 'l2' },
  { index: 3, name: 'Repository memory', life: 'persists', tone: 'l3' },
  { index: 4, name: 'User memory', life: 'persists', tone: 'l4' },
  { index: 5, name: 'Source-controlled knowledge', life: 'versioned', tone: 'l5' },
];

const headings: TocHeading[] = [
  { depth: 2, slug: 'one-minute-version', text: 'The one-minute version' },
  { depth: 2, slug: 'read-it-in-order', text: 'Read it in order' },
  { depth: 2, slug: 'how-to-read-this-site', text: 'How to read this site' },
];
---

<BaseLayout
  title="GitHub Copilot Memory Layers — an interactive guide"
  description="An interactive, source-backed guide to how GitHub Copilot remembers things: six layers, three scopes, and the lifecycle that retires what stops being useful."
  page="home"
  wide={true}
  prose={false}
  headings={headings}
  jsonLd={jsonLd}
>
  <section class="hero">
    <p class="hero__eyebrow">
      <span class="badge badge--accent">Unofficial</span>
      Built from official documentation · verified {verified}
    </p>
    <h1>Copilot remembers things. <em>Here is exactly what, where, and for how long.</em></h1>
    <p class="hero__sub">
      GitHub Copilot keeps knowledge in at least six different places, across three scopes,
      with three completely different lifetimes. This site pulls those layers apart, cites the
      official documentation for every claim, and lets you step through the mechanics yourself.
    </p>
    <div class="hero__actions">
      <a class="btn btn--primary" href={withBase('layers/')}>Start with the six layers</a>
      <a class="btn" href={withBase('concepts/')}>Why “memory” is ambiguous</a>
      <a class="btn btn--ghost" href={withBase('sources/')}>Read the sources</a>
    </div>

    <div class="teaser" aria-hidden="true">
      {teaserLayers.map((layer) => (
        <div
          class="teaser__row"
          style={`--tone: var(--${layer.tone}); --i: ${layer.index}`}
        >
          <span class="teaser__num">{layer.index}</span>
          <span class="teaser__bar">{layer.name}</span>
          <span class="teaser__life">{layer.life}</span>
        </div>
      ))}
    </div>

    <div class="hero__meta">
      <div><strong>{chapters.length}</strong> chapters</div>
      <div><strong>4</strong> interactive diagrams</div>
      <div><strong>{sources.length}</strong> official sources</div>
      <div>No tracking · No network calls</div>
    </div>
  </section>

  <section class="section reveal">
    <div class="section__head">
      <h2 id="one-minute-version">The one-minute version</h2>
      <p>Four numbers that explain most of the confusion.</p>
    </div>
    <div class="fact-strip">
      <div class="fact">
        <span class="fact__value">3</span>
        <span class="fact__label">local memory scopes: session, repository, user</span>
      </div>
      <div class="fact">
        <span class="fact__value">2</span>
        <span class="fact__label">cloud scopes: repository facts and user preferences</span>
      </div>
      <div class="fact">
        <span class="fact__value">90 days</span>
        <span class="fact__label">default expiry for cloud memories that go unused</span>
      </div>
      <div class="fact">
        <span class="fact__value">200 lines</span>
        <span class="fact__label">of local user memory loaded at the start of every session</span>
      </div>
    </div>
  </section>

  <section class="section reveal">
    <div class="section__head">
      <h2 id="read-it-in-order">Read it in order</h2>
      <p>Each chapter stands alone, but the argument builds.</p>
    </div>
    <div class="chapter-grid" id="chapter-grid">
      {chapters.map((chapter) => <ChapterCard chapter={chapter} />)}
    </div>
  </section>

  <section class="section reveal">
    <div class="section__head">
      <h2 id="how-to-read-this-site">How to read this site</h2>
      <p>Small badges appear next to claims.</p>
    </div>
    <div class="prose">
      <p>
        Numbers in small boxes are citations. Each one points at an official source card at the
        bottom of the page, so you can check the claim instead of trusting this site.
        Anything marked <span class="badge badge--warn">Experimental</span> or
        <span class="badge">Preview</span> can change without notice.
      </p>
      <Callout variant="warn" label="Not a rulebook">
        <p>
          Instructions and memory both guide the model. Neither one is enforcement. If a rule must
          hold every time, it belongs in a hook, a test, or code review — not in a Markdown file.
          <Cite id="vscode-customization" />
        </p>
      </Callout>
      <SourceList ids={['vscode-customization']} />
    </div>
  </section>
</BaseLayout>
