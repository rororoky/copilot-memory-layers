---
import { render } from 'astro:content';
import ChapterLayout from '../layouts/ChapterLayout.astro';
import {
  entryToChapter,
  getChapterEntries,
  type ChapterEntry,
} from '../lib/chapters';
import type { Chapter } from '../data/chapters';

interface Props {
  entry: ChapterEntry;
  chapters: Chapter[];
}

export async function getStaticPaths() {
  const entries = await getChapterEntries();
  const chapters = entries.map(entryToChapter);

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, chapters },
  }));
}

const { entry, chapters } = Astro.props as Props;
const chapter = entryToChapter(entry);
const { Content, headings } = await render(entry);
---

<ChapterLayout
  chapter={chapter}
  chapters={chapters}
  headings={headings}
  sources={entry.data.sources}
  lede={entry.data.lede ?? entry.data.description}
  description={entry.data.description}
>
  <Content />
</ChapterLayout>
